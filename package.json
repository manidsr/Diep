{
  "name": "tank-lan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diep-style tank arena for LAN / phone-hotspot play",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "start": "npm run build && tsx src/server/index.ts",
    "start:only": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
